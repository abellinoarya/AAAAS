# AAAAS configuration — copy to .env and fill in.
# Every value has a safe default; the system runs in in-memory demo mode
# out of the box with nothing set.

# ---- Odoo connection ----
# Set AAAAS_ODOO_IN_MEMORY=false to talk to a real Odoo instance.
AAAAS_ODOO_IN_MEMORY=true
AAAAS_ODOO_URL=http://localhost:8069
AAAAS_ODOO_DB=odoo
AAAAS_ODOO_USERNAME=admin
AAAAS_ODOO_PASSWORD=admin

# ---- Claude / LLM (optional) ----
# Only needed to run the agent with a real LLM brain.
AAAAS_ANTHROPIC_API_KEY=
AAAAS_MODEL=claude-sonnet-4-6

# ---- Policy thresholds ----
AAAAS_PRICE_VARIANCE_PCT=0.03
AAAAS_PAYMENT_HITL_LIMIT=1000
AAAAS_REMINDER_AUTO_MAX_DAYS=30

# ---- Confidence gates ----
AAAAS_CONF_AUTO=0.90
AAAAS_CONF_AUTO_FLAG=0.70
AAAAS_CONF_DRAFT_HITL=0.50

# ---- Personality: professional | friendly | genz ----
AAAAS_PERSONALITY=professional

# ---- Notifications ----
AAAAS_FINANCE_CHANNEL=#finance
